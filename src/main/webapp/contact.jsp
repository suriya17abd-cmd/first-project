<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Contact"/><!doctype html><html><head><%@ include file="WEB-INF/views/common/head.jspf" %></head><body><nav class="navbar navbar-dark public-nav"><div class="container"><a class="navbar-brand" href="./"><i class="fa-solid fa-qrcode me-2 text-warning"></i>QRID Campus</a><a class="btn btn-warning" href="login">Portal Login</a></div></nav><main class="section-space"><div class="container"><div class="row g-5"><div class="col-lg-5"><span class="text-brand fw-bold">CONTACT</span><h1 class="display-5 fw-bold mt-2">Speak with the campus identity team.</h1><p class="text-secondary">Use this form for onboarding, access, or deployment questions. Messages are recorded securely for administrator follow-up.</p><div class="mt-4"><p><i class="fa-solid fa-envelope text-brand me-3"></i>support@qrid.local</p><p><i class="fa-solid fa-location-dot text-brand me-3"></i>Institution Administration Office</p></div></div><div class="col-lg-7"><div class="panel p-4 p-md-5"><%@ include file="WEB-INF/views/common/flash.jspf" %><form method="post" action="contact"><div class="row g-3"><div class="col-md-6"><label class="form-label">Name</label><input class="form-control" name="name" maxlength="100" required></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="email" required></div><div class="col-12"><label class="form-label">Subject</label><input class="form-control" name="subject" maxlength="160"></div><div class="col-12"><label class="form-label">Message</label><textarea class="form-control" rows="5" name="message" minlength="10" maxlength="2000" required></textarea></div><div class="col-12"><button class="btn btn-primary"><i class="fa-solid fa-paper-plane me-2"></i>Send Message</button></div></div></form></div></div></div></div></main><%@ include file="WEB-INF/views/common/scripts.jspf" %></body></html>
