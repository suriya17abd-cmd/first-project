<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Secure Digital Identity"/><!doctype html><html><head><%@ include file="WEB-INF/views/common/head.jspf" %></head><body>
<nav class="navbar navbar-expand-lg navbar-dark public-nav fixed-top"><div class="container"><a class="navbar-brand" href="${pageContext.request.contextPath}/"><i class="fa-solid fa-qrcode me-2 text-warning"></i>QRID Campus</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div id="nav" class="collapse navbar-collapse"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><a class="nav-link" href="about.jsp">About</a><a class="nav-link" href="features.jsp">Features</a><a class="nav-link" href="contact.jsp">Contact</a><a class="btn btn-warning ms-lg-3" href="login"><i class="fa-solid fa-right-to-bracket me-2"></i>Portal Login</a></div></div></div></nav>
<main><section class="hero"><div class="container"><div class="row align-items-center g-5"><div class="col-lg-7"><span class="badge rounded-pill text-bg-warning mb-4"><i class="fa-solid fa-shield-halved me-2"></i>Fast. Revocable. Auditable.</span><h1>One secure identity for every campus moment.</h1><p class="lead mt-4 text-white-50">Issue tamper-resistant digital IDs, verify them instantly through QR scanning, and understand campus access from a single privacy-aware platform.</p><div class="d-flex flex-wrap gap-3 mt-4"><a class="btn btn-warning btn-lg" href="login">Open secure portal</a><a class="btn btn-outline-light btn-lg" href="features.jsp">Explore features</a></div></div><div class="col-lg-5"><div class="hero-card"><div class="glass-id"><div class="d-flex justify-content-between"><div><small class="text-secondary">INSTITUTIONAL IDENTITY</small><h4 class="text-brand mt-1">Aarav S</h4></div><i class="fa-solid fa-building-columns fs-2 text-brand"></i></div><div class="row mt-4 align-items-center"><div class="col-7"><p class="mb-1"><strong>STU/CSE/2026/001</strong></p><small class="text-secondary">Computer Science<br>Valid until May 2029</small><div class="mt-3"><span class="status status-ACTIVE">ACTIVE</span></div></div><div class="col-5 text-center"><i class="fa-solid fa-qrcode text-dark" style="font-size:6rem"></i></div></div></div></div></div></div></section>
<section class="section-space"><div class="container"><div class="text-center mb-5"><span class="text-brand fw-bold">BUILT FOR EDUCATION</span><h2 class="display-6 fw-bold mt-2">Identity management without the bottlenecks</h2></div><div class="row g-4"><div class="col-md-4"><div class="feature-card"><div class="icon-box"><i class="fa-solid fa-id-card"></i></div><h4 class="mt-4">Digital issuance</h4><p class="text-secondary">Create individual identities or onboard complete batches through structured CSV import.</p></div></div><div class="col-md-4"><div class="feature-card"><div class="icon-box"><i class="fa-solid fa-camera"></i></div><h4 class="mt-4">Camera verification</h4><p class="text-secondary">Use any approved browser camera while Google ZXing validates QR data on the server.</p></div></div><div class="col-md-4"><div class="feature-card"><div class="icon-box"><i class="fa-solid fa-chart-line"></i></div><h4 class="mt-4">Campus visibility</h4><p class="text-secondary">Review entry history, validity outcomes, weekly traffic, exports, and a complete audit trail.</p></div></div></div></div></section>
<section class="section-space bg-white"><div class="container"><div class="row g-5 align-items-center"><div class="col-lg-6"><span class="text-brand fw-bold">HOW IT WORKS</span><h2 class="display-6 fw-bold my-3">From enrolment to verified entry in four steps.</h2><p class="text-secondary">Administrators or authorised department staff issue a record. The portal generates a unique, revocable QR token and downloadable PDF card. Security scans it at the gate. The backend evaluates status and validity before recording the event.</p></div><div class="col-lg-6"><div class="row g-3"><c:forEach var="step" varStatus="st" items="${['Create identity','Generate secure QR','Scan at checkpoint','Log and analyse']}"><div class="col-6"><div class="feature-card"><div class="fs-3 fw-bold text-brand">0${st.index+1}</div><div class="fw-bold mt-2">${step}</div></div></div></c:forEach></div></div></div></section>
</main><footer class="public-footer"><div class="container d-flex flex-wrap justify-content-between gap-3"><div><strong class="text-white">QRID Campus</strong><div>Secure identity for safer institutions.</div></div><div>Java 17 | JSP/Servlet | MySQL 8 | ZXing</div></div></footer><%@ include file="WEB-INF/views/common/scripts.jspf" %></body></html>
