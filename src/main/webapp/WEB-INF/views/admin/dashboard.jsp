<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Administrator Dashboard"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><%@ include file="../common/flash.jspf" %><div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><h2 class="fw-bold mb-1">Institution overview</h2><p class="text-secondary mb-0">Identity lifecycle, access traffic, and platform control.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/admin/bulk-import"><i class="fa-solid fa-file-csv me-2"></i>Bulk Import</a><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/identity-form"><i class="fa-solid fa-plus me-2"></i>Issue ID</a></div></div>
<div class="row g-3"><div class="col-sm-6 col-xl-3"><div class="panel stat-card"><div class="text-secondary">All identities</div><div class="stat-value">${totalIdentities}</div></div></div><div class="col-sm-6 col-xl-3"><div class="panel stat-card"><div class="text-secondary">Active</div><div class="stat-value">${activeIdentities}</div></div></div><div class="col-sm-6 col-xl-3"><div class="panel stat-card"><div class="text-secondary">Suspended</div><div class="stat-value">${suspended}</div></div></div><div class="col-sm-6 col-xl-3"><div class="panel stat-card"><div class="text-secondary">Scans today</div><div class="stat-value">${todayScans}</div></div></div></div>
<div class="row g-4 mt-1"><div class="col-xl-8"><div class="panel p-4"><div class="d-flex justify-content-between mb-3"><h5 class="fw-bold">Recent verifications</h5><a href="${pageContext.request.contextPath}/admin/reports">View reports</a></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Identity</th><th>Department</th><th>Gate</th><th>Result</th><th>Time</th></tr></thead><tbody><c:forEach var="x" items="${recentScans}"><tr><td><strong>${x.full_name}</strong><br><small>${x.identity_no}</small></td><td>${x.department}</td><td>${x.gate_location}</td><td><span class="status status-${x.result}">${x.result}</span></td><td><small>${x.scanned_at}</small></td></tr></c:forEach><c:if test="${empty recentScans}"><tr><td colspan="5" class="text-center text-secondary py-4">No scans recorded yet.</td></tr></c:if></tbody></table></div></div></div><div class="col-xl-4"><div class="panel p-4"><h5 class="fw-bold">Quick control</h5><div class="d-grid gap-2 mt-3"><a class="btn btn-outline-primary text-start" href="${pageContext.request.contextPath}/admin/users"><i class="fa-solid fa-users me-2"></i>Manage portal users</a><a class="btn btn-outline-primary text-start" href="${pageContext.request.contextPath}/security/scanner"><i class="fa-solid fa-camera me-2"></i>Open QR scanner</a><a class="btn btn-outline-primary text-start" href="${pageContext.request.contextPath}/admin/audit"><i class="fa-solid fa-clock-rotate-left me-2"></i>Review audit trail</a></div></div></div></div></div></main></div><%@ include file="../common/scripts.jspf" %></body></html>
