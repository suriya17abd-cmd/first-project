<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Audit Trail"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><h2 class="fw-bold">Administrative audit trail</h2><p class="text-secondary">Immutable event history for security review and accountability.</p><div class="panel p-3 mt-4"><div class="table-responsive"><table class="table"><thead><tr><th>Timestamp</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr></thead><tbody><c:forEach var="x" items="${auditLogs}"><tr><td><small>${x.created_at}</small></td><td>${x.user_name}</td><td><strong>${x.action}</strong></td><td>${x.entity_type} ${x.entity_id}</td><td>${x.details}</td><td><small>${x.ip_address}</small></td></tr></c:forEach></tbody></table></div></div></div></main></div><%@ include file="../common/scripts.jspf" %></body></html>
