<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Portal Users"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><%@ include file="../common/flash.jspf" %><div class="row g-4"><div class="col-xl-8"><div class="panel p-3"><div class="d-flex justify-content-between align-items-center mb-3"><h4 class="fw-bold mb-0">Authorised accounts</h4><form><input class="form-control" name="q" placeholder="Search users" value="${param.q}"></form></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>User</th><th>Role</th><th>Department</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="u" items="${users}"><tr><td><strong>${u.name}</strong><br><small>${u.email}</small></td><td>${u.role}</td><td>${u.department}</td><td><span class="status status-${u.status}">${u.status}</span></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="?edit=${u.id}"><i class="fa-solid fa-pen-to-square"></i></a><form class="d-inline" method="post"><input type="hidden" name="action" value="toggle"><input type="hidden" name="id" value="${u.id}"><button class="btn btn-sm btn-outline-danger" ${u.id eq sessionScope.user.id?'disabled':''}><i class="fa-solid fa-ban"></i></button></form></td></tr></c:forEach></tbody></table></div></div></div><div class="col-xl-4"><div class="panel p-4"><h4 class="fw-bold">${empty editUser?'Create user':'Edit user'}</h4><form method="post" class="mt-3"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="${editUser.id}"><div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" value="${editUser.name}" required></div><div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="${editUser.email}" required></div><div class="mb-3"><label class="form-label">Role</label><select class="form-select" name="role"><option ${editUser.role eq 'ADMIN'?'selected':''}>ADMIN</option><option ${editUser.role eq 'SECURITY'?'selected':''}>SECURITY</option><option ${editUser.role eq 'STAFF'?'selected':''}>STAFF</option></select></div><div class="mb-3"><label class="form-label">Department</label><input class="form-control" name="department" value="${editUser.department}"></div><div class="mb-3"><label class="form-label">Password ${not empty editUser?'(leave blank to retain)':''}</label><input class="form-control" type="password" name="password" minlength="8" ${empty editUser?'required':''}></div><input type="hidden" name="status" value="${empty editUser?'ACTIVE':editUser.status}"><button class="btn btn-primary w-100"><i class="fa-solid fa-floppy-disk me-2"></i>Save Account</button></form></div></div></div></div></main></div><%@ include file="../common/scripts.jspf" %></body></html>
