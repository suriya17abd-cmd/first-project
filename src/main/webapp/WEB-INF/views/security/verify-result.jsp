<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Verification Result"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><c:choose><c:when test="${not empty scanError}"><div class="verify-card panel verify-invalid p-5 text-center"><i class="fa-solid fa-qrcode fs-1 text-danger"></i><h2 class="fw-bold mt-3">QR not detected</h2><p class="text-secondary">${scanError}</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/security/scanner">Try Again</a></div></c:when><c:otherwise><div class="verify-card panel ${result eq 'VALID'?'verify-valid':'verify-invalid'}"><div class="p-4 text-center ${result eq 'VALID'?'bg-success':'bg-danger'} text-white"><i class="fa-solid ${result eq 'VALID'?'fa-circle-check':'fa-circle-xmark'} fs-1"></i><h1 class="fw-bold mt-2">${result}</h1><p class="mb-0">${result eq 'VALID'?'Identity accepted':'Access must not be granted'}</p></div><div class="p-4"><c:choose><c:when test="${not empty identity}"><div class="row align-items-center g-4"><div class="col-sm-4 text-center"><c:choose><c:when test="${not empty identity.photoMime}"><img class="photo-preview" src="${pageContext.request.contextPath}/identity-photo?id=${identity.id}"></c:when><c:otherwise><div class="avatar mx-auto">${identity.fullName.substring(0,1)}</div></c:otherwise></c:choose></div><div class="col-sm-8"><h3 class="fw-bold">${identity.fullName}</h3><p class="mb-1"><strong>ID:</strong> ${identity.identityNo}</p><p class="mb-1"><strong>Department:</strong> ${identity.department}</p><p class="mb-1"><strong>Course:</strong> ${identity.course}</p><p class="mb-0"><strong>Valid until:</strong> ${identity.validUntil}</p></div></div></c:when><c:otherwise><p class="text-center text-secondary">The scanned token is not registered in this system.</p></c:otherwise></c:choose><div class="d-grid mt-4"><a class="btn btn-primary btn-lg" href="${pageContext.request.contextPath}/security/scanner"><i class="fa-solid fa-camera me-2"></i>Scan Next Identity</a></div></div></div></c:otherwise></c:choose></div></main></div><%@ include file="../common/scripts.jspf" %></body></html>
