<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="QR Camera Scanner"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><div class="text-center mb-4"><h2 class="fw-bold">Secure checkpoint scanner</h2><p class="text-secondary">Camera frames are sent to the Java backend and decoded using Google ZXing.</p><div class="d-flex justify-content-center gap-2"><select id="gate" class="form-select" style="max-width:220px"><option>Main Gate</option><option>Library Entrance</option><option>Examination Hall</option><option>Hostel Gate</option></select><button id="start" class="btn btn-primary"><i class="fa-solid fa-camera me-2"></i>Start Camera</button><button id="capture" class="btn btn-warning" disabled><i class="fa-solid fa-qrcode me-2"></i>Scan QR</button></div></div><div class="camera-box"><video id="video" autoplay playsinline></video><div class="scan-guide"></div><canvas id="canvas" class="d-none"></canvas></div><div id="cameraError" class="alert alert-danger mt-3 d-none"></div><form id="scanForm" method="post" action="${pageContext.request.contextPath}/security/scanner" class="d-none"><input id="frame" name="frame"></form></div></main></div><script>const v=document.getElementById('video'),c=document.getElementById('canvas'),start=document.getElementById('start'),capture=document.getElementById('capture'),error=document.getElementById('cameraError');start.onclick=async()=>{try{v.srcObject=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'}},audio:false});capture.disabled=false;start.disabled=true}catch(e){error.textContent='Camera access failed. Use localhost or HTTPS and allow camera permission.';error.classList.remove('d-none')}};capture.onclick=async()=>{capture.disabled=true;capture.innerHTML='<i class="fa-solid fa-spinner fa-spin me-2"></i>Decoding';c.width=v.videoWidth;c.height=v.videoHeight;c.getContext('2d').drawImage(v,0,0);try{const response=await fetch('${pageContext.request.contextPath}/security/scanner?gate='+encodeURIComponent(document.getElementById('gate').value),{method:'POST',headers:{'Content-Type':'text/plain','X-CSRF-Token':document.querySelector('meta[name="csrf-token"]').content},body:c.toDataURL('image/jpeg',.86)});document.open();document.write(await response.text());document.close()}catch(e){error.textContent='Could not contact the verification service.';error.classList.remove('d-none');capture.disabled=false}}</script><%@ include file="../common/scripts.jspf" %></body></html>
