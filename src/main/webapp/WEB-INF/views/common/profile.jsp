<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="My Profile"/><!doctype html><html><head><%@ include file="head.jspf" %></head><body><div class="app-shell"><%@ include file="sidebar.jspf" %><main class="main"><%@ include file="topbar.jspf" %><div class="content"><%@ include file="flash.jspf" %><div class="row g-4"><div class="col-lg-5"><div class="panel p-4"><div class="avatar mb-3">${sessionScope.user.name.substring(0,1)}</div><h3 class="fw-bold">${sessionScope.user.name}</h3><p class="text-secondary">${sessionScope.user.email}</p><hr><p><strong>Role:</strong> ${sessionScope.user.role}</p><p><strong>Department:</strong> ${sessionScope.user.department}</p><p><strong>Status:</strong> <span class="status status-${sessionScope.user.status}">${sessionScope.user.status}</span></p></div></div><div class="col-lg-7"><div class="panel p-4"><h4 class="fw-bold">Change password</h4><p class="text-secondary">Use at least eight characters and do not reuse the default password.</p><form method="post"><div class="mb-3"><label class="form-label">Current password</label><input class="form-control" type="password" name="currentPassword" required></div><div class="mb-3"><label class="form-label">New password</label><input class="form-control" type="password" name="newPassword" minlength="8" required></div><div class="mb-4"><label class="form-label">Confirm new password</label><input class="form-control" type="password" name="confirmPassword" minlength="8" required></div><button class="btn btn-primary"><i class="fa-solid fa-key me-2"></i>Update Password</button></form></div></div></div></div></main></div><%@ include file="scripts.jspf" %></body></html>
