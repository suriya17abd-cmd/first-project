<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Features"/><!doctype html><html><head><%@ include file="WEB-INF/views/common/head.jspf" %></head><body><nav class="navbar navbar-dark public-nav"><div class="container"><a class="navbar-brand" href="./"><i class="fa-solid fa-qrcode me-2 text-warning"></i>QRID Campus</a><a class="btn btn-warning" href="login">Portal Login</a></div></nav><main class="section-space"><div class="container"><div class="text-center mb-5"><span class="text-brand fw-bold">CAPABILITIES</span><h1 class="display-5 fw-bold">Everything required for trusted campus access</h1></div><div class="row g-4"><c:forEach var="f" items="${['Individual and CSV bulk issuance','JPG/PNG photo validation','Versioned PDF identity cards','Google ZXing QR generation','Webcam capture and backend decoding','Active, suspended and graduated status','Admin, security and department roles','Daily and weekly scan analytics','CSV security report export','Complete administrative audit trail','Secure session and logout handling','Responsive multi-page interface']}"><div class="col-md-6 col-lg-4"><div class="feature-card"><i class="fa-solid fa-circle-check text-brand fs-4"></i><h5 class="mt-3">${f}</h5><p class="text-secondary mb-0">Implemented as part of the working Java backend and institutional portal.</p></div></div></c:forEach></div></div></main><footer class="public-footer"><div class="container">QRID Campus | Fast verification without dedicated card readers</div></footer><%@ include file="WEB-INF/views/common/scripts.jspf" %></body></html>
