<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="isAdmin" value="${sessionScope.user.role eq 'ADMIN'}"/><%@ include file="flash.jspf" %><div class="d-flex justify-content-between flex-wrap mb-4"><div><h2 class="fw-bold">${empty identity ? 'Issue a digital identity' : 'Update digital identity'}</h2><p class="text-secondary">The QR token is generated securely by the server and never entered manually.</p></div><a class="btn btn-light align-self-center" href="${isAdmin?'identities':'identities'}"><i class="fa-solid fa-arrow-left me-2"></i>Back</a></div><form class="panel p-4" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="${identity.id}"><div class="row g-4"><div class="col-md-4"><label class="form-label">Identity number</label><input class="form-control" name="identityNo" value="${identity.identityNo}" maxlength="40" pattern="[A-Za-z0-9/_-]{3,40}" required></div><div class="col-md-8"><label class="form-label">Full name</label><input class="form-control" name="fullName" value="${identity.fullName}" maxlength="120" required></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="${identity.email}" required></div><div class="col-md-3"><label class="form-label">Person type</label><select class="form-select" name="personType" required><option value="STUDENT" ${identity.personType eq 'STUDENT'?'selected':''}>Student</option><option value="STAFF" ${identity.personType eq 'STAFF'?'selected':''}>Staff</option></select></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="status"><option ${identity.status eq 'ACTIVE'?'selected':''}>ACTIVE</option><option ${identity.status eq 'SUSPENDED'?'selected':''}>SUSPENDED</option><option ${identity.status eq 'GRADUATED'?'selected':''}>GRADUATED</option></select></div><div class="col-md-6"><label class="form-label">Department</label><c:choose><c:when test="${isAdmin}"><input class="form-control" name="department" value="${identity.department}" maxlength="100" required></c:when><c:otherwise><input class="form-control" value="${sessionScope.user.department}" disabled><input type="hidden" name="department" value="${sessionScope.user.department}"></c:otherwise></c:choose></div><div class="col-md-6"><label class="form-label">Course / designation</label><input class="form-control" name="course" value="${identity.course}" maxlength="120"></div><div class="col-md-3"><label class="form-label">Valid from</label><input class="form-control" type="date" name="validFrom" value="${identity.validFrom}" required></div><div class="col-md-3"><label class="form-label">Valid until</label><input class="form-control" type="date" name="validUntil" value="${identity.validUntil}" required></div><div class="col-md-6"><label class="form-label">Photo (JPG/PNG, max 3 MB)</label><input class="form-control" type="file" name="photo" accept="image/jpeg,image/png" ${empty identity?'required':''}></div><c:if test="${not empty identity.photoMime}"><div class="col-12"><img class="photo-preview" src="${pageContext.request.contextPath}/identity-photo?id=${identity.id}" alt="Current identity photo"></div></c:if><div class="col-12"><hr><button class="btn btn-primary btn-lg"><i class="fa-solid fa-floppy-disk me-2"></i>${empty identity?'Issue Identity':'Save Changes'}</button></div></div></form>
