<div class="d-flex justify-content-between flex-wrap gap-3 mb-4"><div><h2 class="fw-bold">Verification activity</h2><p class="text-secondary mb-0">Recorded checkpoint events with identity, location, result, and verifier.</p></div><c:if test="${sessionScope.user.role eq 'ADMIN'}"><a class="btn btn-primary align-self-center" href="${pageContext.request.contextPath}/admin/export-scans"><i class="fa-solid fa-file-arrow-down me-2"></i>Export CSV</a></c:if></div><div class="panel p-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Time</th><th>Identity</th><th>Department</th><th>Gate</th><th>Result</th><th>Verified by</th></tr></thead><tbody><c:forEach var="x" items="${scanLogs}"><tr><td><small>${x.scanned_at}</small></td><td><strong>${x.full_name}</strong><br><small>${x.identity_no}</small></td><td>${x.department}</td><td>${x.gate_location}</td><td><span class="status status-${x.result}">${x.result}</span></td><td>${x.verified_by}</td></tr></c:forEach><c:if test="${empty scanLogs}"><tr><td colspan="6" class="text-center py-5 text-secondary">No verification activity has been recorded.</td></tr></c:if></tbody></table></div></div>
