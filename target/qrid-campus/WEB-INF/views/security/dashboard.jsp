<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Security Dashboard"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><h2 class="fw-bold">Checkpoint operations</h2><p class="text-secondary">Verify identities quickly and monitor today's access results.</p><div class="row g-3 my-3"><div class="col-md-4"><div class="panel stat-card"><div class="text-secondary">Scans today</div><div class="stat-value">${todayScans}</div></div></div><div class="col-md-4"><div class="panel stat-card"><div class="text-secondary">Active identities</div><div class="stat-value">${activeIdentities}</div></div></div><div class="col-md-4"><a class="panel stat-card text-decoration-none d-block bg-brand text-white" href="${pageContext.request.contextPath}/security/scanner"><div>Start verification</div><div class="fs-2 fw-bold">Open camera <i class="fa-solid fa-camera ms-2"></i></div></a></div></div><div class="panel p-4"><h5 class="fw-bold mb-3">Latest checkpoint events</h5><div class="table-responsive"><table class="table"><thead><tr><th>Person</th><th>Gate</th><th>Result</th><th>Time</th></tr></thead><tbody><c:forEach var="x" items="${recentScans}"><tr><td><strong>${x.full_name}</strong><br><small>${x.identity_no}</small></td><td>${x.gate_location}</td><td><span class="status status-${x.result}">${x.result}</span></td><td>${x.scanned_at}</td></tr></c:forEach></tbody></table></div></div></div></main></div><%@ include file="../common/scripts.jspf" %></body></html>
