<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Digital Identities"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><%@ include file="../common/flash.jspf" %><div class="d-flex justify-content-between flex-wrap gap-3 mb-4"><div><h2 class="fw-bold">Identity repository</h2><p class="text-secondary mb-0">Search, download, suspend, reactivate, or regenerate an identity.</p></div><a class="btn btn-primary align-self-center" href="${pageContext.request.contextPath}/admin/identity-form"><i class="fa-solid fa-plus me-2"></i>Issue New ID</a></div><div class="panel p-3 mb-4"><form class="row g-2"><div class="col-md-5"><input class="form-control" name="q" value="${param.q}" placeholder="Search name, ID or email"></div><div class="col-md-3"><select class="form-select" name="status"><option value="">All statuses</option><option>ACTIVE</option><option>SUSPENDED</option><option>GRADUATED</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100"><i class="fa-solid fa-magnifying-glass me-2"></i>Search</button></div><div class="col-md-2"><a class="btn btn-light w-100" href="identities">Reset</a></div></form></div><div class="panel p-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Identity</th><th>Person</th><th>Department</th><th>Validity</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody><c:forEach var="x" items="${identities}"><tr><td><strong>${x.identityNo}</strong><br><small>Version ${x.version}</small></td><td><div class="d-flex align-items-center gap-2"><c:choose><c:when test="${not empty x.photoMime}"><img src="${pageContext.request.contextPath}/identity-photo?id=${x.id}" class="avatar" style="object-fit:cover"></c:when><c:otherwise><div class="avatar">${x.fullName.substring(0,1)}</div></c:otherwise></c:choose><div><strong>${x.fullName}</strong><br><small>${x.email}</small></div></div></td><td>${x.department}<br><small>${x.course}</small></td><td><small>${x.validFrom}<br>${x.validUntil}</small></td><td><span class="status status-${x.status}">${x.status}</span></td><td class="text-end"><div class="btn-group"><a class="btn btn-sm btn-outline-primary" title="Download PDF" href="${pageContext.request.contextPath}/card?id=${x.id}"><i class="fa-solid fa-download"></i></a><a class="btn btn-sm btn-outline-secondary" title="Edit" href="identity-form?id=${x.id}"><i class="fa-solid fa-pen-to-square"></i></a><button class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown"></button><ul class="dropdown-menu dropdown-menu-end"><li><form method="post"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="${x.id}"><input type="hidden" name="status" value="${x.status eq 'ACTIVE'?'SUSPENDED':'ACTIVE'}"><button class="dropdown-item"><i class="fa-solid fa-ban me-2"></i>${x.status eq 'ACTIVE'?'Suspend':'Reactivate'}</button></form></li><li><form method="post"><input type="hidden" name="action" value="regenerate"><input type="hidden" name="id" value="${x.id}"><button class="dropdown-item"><i class="fa-solid fa-rotate me-2"></i>Regenerate QR</button></form></li><li><hr class="dropdown-divider"></li><li><form method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${x.id}"><button class="dropdown-item text-danger" data-confirm="Delete this identity and all generated cards?"><i class="fa-solid fa-trash me-2"></i>Delete</button></form></li></ul></div></td></tr></c:forEach><c:if test="${empty identities}"><tr><td colspan="6" class="text-center py-5 text-secondary">No identity records match the filter.</td></tr></c:if></tbody></table></div></div></div></main></div><%@ include file="../common/scripts.jspf" %></body></html>
