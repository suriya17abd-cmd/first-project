<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Department Identities"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><%@ include file="../common/flash.jspf" %><div class="d-flex justify-content-between mb-4"><div><h2 class="fw-bold">${sessionScope.user.department} identities</h2><p class="text-secondary">Your account is restricted to its assigned department.</p></div><a class="btn btn-primary align-self-center" href="identity-form"><i class="fa-solid fa-plus me-2"></i>Issue ID</a></div><div class="panel p-3 mb-3"><form class="d-flex gap-2"><input class="form-control" name="q" placeholder="Search department identities" value="${param.q}"><button class="btn btn-outline-primary">Search</button></form></div><div class="panel p-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>ID</th><th>Name</th><th>Course</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody><c:forEach var="x" items="${identities}"><tr><td>${x.identityNo}</td><td><strong>${x.fullName}</strong><br><small>${x.email}</small></td><td>${x.course}</td><td><span class="status status-${x.status}">${x.status}</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/card?id=${x.id}"><i class="fa-solid fa-download"></i></a><a class="btn btn-sm btn-outline-secondary" href="identity-form?id=${x.id}"><i class="fa-solid fa-pen-to-square"></i></a><form method="post" class="d-inline"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="${x.id}"><input type="hidden" name="status" value="${x.status eq 'ACTIVE'?'SUSPENDED':'ACTIVE'}"><button class="btn btn-sm btn-outline-danger" title="Change status"><i class="fa-solid fa-ban"></i></button></form></td></tr></c:forEach></tbody></table></div></div></div></main></div><%@ include file="../common/scripts.jspf" %></body></html>
