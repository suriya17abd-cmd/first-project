<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Department Dashboard"/><!doctype html><html><head><%@ include file="../common/head.jspf" %></head><body><div class="app-shell"><%@ include file="../common/sidebar.jspf" %><main class="main"><%@ include file="../common/topbar.jspf" %><div class="content"><div class="d-flex justify-content-between flex-wrap gap-3"><div><h2 class="fw-bold">${sessionScope.user.department}</h2><p class="text-secondary">Issue and maintain identity records within your assigned department.</p></div><a class="btn btn-primary align-self-center" href="${pageContext.request.contextPath}/staff/identity-form"><i class="fa-solid fa-plus me-2"></i>Issue Department ID</a></div><div class="row g-3 my-3"><div class="col-md-4"><div class="panel stat-card"><div class="text-secondary">Department identities</div><div class="stat-value">${totalIdentities}</div></div></div><div class="col-md-4"><div class="panel stat-card"><div class="text-secondary">Active</div><div class="stat-value">${activeIdentities}</div></div></div><div class="col-md-4"><div class="panel stat-card"><div class="text-secondary">Suspended</div><div class="stat-value">${suspended}</div></div></div></div><div class="panel p-4"><h5 class="fw-bold">Recent department scans</h5><div class="table-responsive"><table class="table"><thead><tr><th>Person</th><th>Gate</th><th>Result</th><th>Time</th></tr></thead><tbody><c:forEach var="x" items="${recentScans}"><tr><td>${x.full_name}<br><small>${x.identity_no}</small></td><td>${x.gate_location}</td><td><span class="status status-${x.result}">${x.result}</span></td><td>${x.scanned_at}</td></tr></c:forEach></tbody></table></div></div></div></main></div><%@ include file="../common/scripts.jspf" %></body></html>
