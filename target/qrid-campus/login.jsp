<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="Login"/><!doctype html><html><head><%@ include file="WEB-INF/views/common/head.jspf" %></head><body><main class="auth-shell"><div class="auth-card"><div class="row g-0"><div class="col-lg-6 auth-visual"><a class="text-white text-decoration-none fw-bold fs-4" href="${pageContext.request.contextPath}/"><i class="fa-solid fa-qrcode me-2 text-warning"></i>QRID Campus</a><div class="mt-5"><span class="badge text-bg-warning">SECURE PORTAL</span><h1 class="display-5 fw-bold mt-3">Trusted access begins with verified identity.</h1><p class="text-white-50">Issue, manage, scan, and audit digital identities from one role-aware institutional system.</p></div></div><div class="col-lg-6 auth-form"><h2 class="fw-bold">Welcome back</h2><p class="text-secondary mb-4">Sign in with your authorised institutional account.</p><%@ include file="WEB-INF/views/common/flash.jspf" %><c:if test="${param.logout eq '1'}"><div class="alert alert-success">You have been signed out securely.</div></c:if><form method="post" action="login"><div class="mb-3"><label class="form-label">Email address</label><div class="input-group"><span class="input-group-text"><i class="fa-solid fa-envelope"></i></span><input class="form-control" type="email" name="email" required autocomplete="username"></div></div><div class="mb-4"><label class="form-label">Password</label><div class="input-group"><span class="input-group-text"><i class="fa-solid fa-lock"></i></span><input class="form-control" type="password" name="password" required autocomplete="current-password"></div></div><button class="btn btn-primary btn-lg w-100"><i class="fa-solid fa-right-to-bracket me-2"></i>Sign In</button></form><a href="${pageContext.request.contextPath}/" class="d-block text-center mt-4 text-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Return to home</a></div></div></div></main><%@ include file="WEB-INF/views/common/scripts.jspf" %></body></html>
